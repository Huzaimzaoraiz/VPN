FROM node:20-slim

WORKDIR /app

# Install system utilities (Prisma requires openssl on Debian)
RUN apt-get update && apt-get install -y openssl curl make gcc g++ python3 && rm -rf /var/lib/apt/lists/*

# Install dependencies first for Docker caching
COPY backend/package.json backend/package-lock.json* ./backend/
WORKDIR /app/backend
RUN npm ci || npm install

# Copy proto definitions
COPY proto/ /app/proto/

# Copy backend source
COPY backend/ ./
RUN npx prisma generate
RUN npm run build

ENV NODE_ENV=production
ENV PORT=8000
ENV GRPC_PORT=50051

EXPOSE 8000 50051

CMD ["sh", "-c", "npx prisma db push && npm start"]
