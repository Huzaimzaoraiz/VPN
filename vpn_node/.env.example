# A unique identifier for this specific VPN node
NODE_ID=local-mac-gateway-01

# The domain or hostname associated with this node
HOSTNAME=mac-vpn.local

# Where the VPN node should connect to receive instructions
CONTROLLER_GRPC_URL=localhost:50051

# The Public IP of this node
PUBLIC_IP=127.0.0.1

# The UDP port WireGuard will listen on
LISTEN_PORT=51820

# Region identifier for orchestration
REGION=local

# Set to true for local testing on macOS/Windows where Linux kernels aren't available
MOCK_NETWORKING=true
