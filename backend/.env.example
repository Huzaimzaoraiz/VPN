# PostgreSQL Database Connection String
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/vpn_db

# Secret used to sign JWT authentication tokens (Must be at least 32 chars in production)
SECRET_KEY=dev-super-secret-key-min-32-chars-long-1234

# REST API Port
PORT=8000

# gRPC Server Binding
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# Environment mode (development/production)
NODE_ENV=development
