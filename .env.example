# --- Backend Database Settings ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=vpn_db

# --- Backend API Settings ---
# Used by Prisma to connect to the database (must match settings above)
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/vpn_db

# Secret used to sign JWT authentication tokens (Must be at least 32 chars in production)
JWT_SECRET=dev-super-secret-key-min-32-chars-long-1234

# gRPC Server Binding
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# --- Email Settings (Nodemailer OTP) ---
# Brevo (Sendinblue) recommended
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-brevo-smtp-key"
SMTP_FROM="your-email@example.com"

# --- VPN Node Settings ---
# A unique identifier for this specific VPN node
NODE_ID=aws-main-gateway-01

# The authentication token generated from the Gateways dashboard
NODE_TOKEN=vpn_tok_your_token_here

# The domain or hostname associated with this node
HOSTNAME=aws-vpn.yourdomain.com

# Where the VPN node should connect to receive instructions
# In a unified docker-compose environment, 'backend:50051' connects over the internal network
CONTROLLER_GRPC_URL=backend:50051

# The Public IP of the AWS EC2 instance (Required for WireGuard clients to connect)
PUBLIC_IP=198.51.100.24

# The UDP port WireGuard will listen on
LISTEN_PORT=51820

# Region identifier for orchestration
REGION=us-east-1

# Set to true for local testing on macOS/Windows where Linux kernels aren't available
MOCK_NETWORKING=false
